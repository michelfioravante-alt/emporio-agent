# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# HOST=127.0.0.1
# PORT=8000
# APP_ENV=development
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# RATE_LIMIT_BURST=20
# RATE_LIMIT_WINDOW_SECONDS=60
# DAILY_CHAT_LIMIT=500
# Set to true only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel)
# TRUST_PROXY_HEADERS=false
# Set to true if you get CERTIFICATE_VERIFY_FAILED because an antivirus/proxy inspects HTTPS
# USE_SYSTEM_CERTS=false
